V = 0
SOURCE_DIR = src
INCLUDE_DIR = include
BUILD_DIR = build
FILESYSTEM_DIR = filesystem

LIBDRAGON_PREVIEW = 2
include $(N64_INST)/include/n64.mk

SRCS = $(wildcard $(SOURCE_DIR)/*.c)
OBJS = $(SRCS:$(SOURCE_DIR)/%.c=$(BUILD_DIR)/%.o)

N64_C_AND_CXX_FLAGS += -I$(INCLUDE_DIR)

SRC_VIDEO_DIR = media
SRC_VIDEOS = $(wildcard $(SRC_VIDEO_DIR)/*.mp4)
DST_VIDEOS_MP1 = $(SRC_VIDEOS:$(SRC_VIDEO_DIR)/%.mp4=$(FILESYSTEM_DIR)/%.mp1)

# DFS_FILES = $(DST_VIDEOS_MP1) $(wildcard filesystem/*)
DFS_FILES =

.PHONY: all
all: hicart.z64

.PHONY: clean
clean:
	rm -rf $(BUILD_DIR) filesystem/* *.z64

hicart.z64: N64_ROM_TITLE="Home Invader 64"
hicart.z64: $(BUILD_DIR)/hicart.dfs

$(BUILD_DIR)/hicart.dfs: $(DFS_FILES)
$(BUILD_DIR)/hicart.elf: $(OBJS)

filesystem/%.mp1: $(SRC_VIDEO_DIR)/%.mp4
	$(N64_VIDEOCONV) -o filesystem --codec mpeg1 -w 224 --quality 70 --quick --seek 5 "$<"

-include $(wildcard $(BUILD_DIR)/*.d)
